# ========================================
# ShellCheck 配置文件
# 文档: https://github.com/koalaman/shellcheck/wiki
# ========================================

# 基础设置
shell=bash
severity=info

# ========================================
# 禁用的规则
# ========================================

# 基础禁用
disable=SC1090,SC1091  # 外部文件检查
disable=SC2004         # 在算术变量中，$/${} 是不必要的
disable=SC2012         # 用 find 代替 ls

# 代码质量规则（选择性禁用）
disable=SC2034   # 未使用变量（有时需要保留）
disable=SC2046   # 给变量赋值时使用双引号防止单词拆分
disable=SC2086   # 双引号防止单词拆分和通配符展开
disable=SC2164   # 使用 cd ... || exit 或 cd ... || return
disable=SC2312   # 考虑分别调用命令

# ========================================
# 可选规则启用
# ========================================

# 规则1：添加默认 case 语句
# 规则2：避免空条件
enable=add-default-case,avoid-nullary-conditions

# ========================================
# 文件排除模式
# ========================================
exclude=test/*.sh